Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ------------------------------------------------------------------------------
# 3. Geliştirme Araçları & Editörler (IDE)
# ------------------------------------------------------------------------------
# JetBrains (Android Studio, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code & Antigravity IDE yerel ayarları
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------------------------------------------
# 4. Platform Özel Derleme Çıktıları
# ------------------------------------------------------------------------------
# Android
**/android/app/release/
**/android/app/debug/
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS
**/ios/**/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/**/GeneratedPluginRegistrant.h
**/ios/**/GeneratedPluginRegistrant.m

# Windows Masaüstü
**/windows/flutter/ephemeral/
**/windows/**/GeneratedPluginRegistrant.cc
**/windows/**/GeneratedPluginRegistrant.h
# Flutter generated Windows plugin registrant
**/windows/flutter/generated_plugin_registrant.*

# Web
**/web/build/

